# Tutte le variabili sono OPZIONALI: senza, il server usa le fonti pubbliche.
# Copiare in .env solo se serve cambiare qualcosa.

# User-Agent identificabile. La usage policy di Overpass lo RICHIEDE:
# senza un contatto valido le richieste possono essere bloccate.
TREKKING_MCP_UA="trekking-mcp/0.1 (+https://github.com/19Alma98/trekking_mcp)"

# Istanza Overpass. Quella pubblica ha rate limit stretti: per un uso
# intensivo conviene farne girare una propria.
# OVERPASS_URL="https://overpass-api.de/api/interpreter"

# Fonti bollettini e meteo
# AINEVA_CAAML_URL="https://bollettini.aineva.it"
# SLF_CAAML_URL="https://aws.slf.ch/api/bulletin/caaml"
# METEO_URL="https://api.open-meteo.com/v1/forecast"

# HTTP
# HTTP_TIMEOUT=30
# HTTP_MAX_RETRY=3

# Cache (secondi)
# TTL_OVERPASS=86400
# TTL_BOLLETTINO=1800
# TTL_METEO=900

# --- Fase 2 ---

# Perimetri delle zone valanghe (progetto EAWS Regions). Scaricati al primo
# uso e tenuti in cache su disco per 30 giorni: NON sono nel repo, perche'
# distribuire perimetri di sicurezza obsoleti e' peggio che non distribuirli.
# EAWS_REGIONS_URL="https://regions.avalanches.org"
# TTL_REGIONI=2592000

# Geocoding. La usage policy di Nominatim impone max 1 richiesta al secondo:
# non abbassare l'intervallo su un'istanza pubblica.
# NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
# NOMINATIM_INTERVALLO=1.0

# Concorrenza massima verso Overpass (default 1: serializza le query nel processo).
# OVERPASS_CONCURRENCY=1

# Modello di elevazione per i profili altimetrici
# ELEVAZIONE_URL="https://api.open-meteo.com/v1/elevation"
# TTL_ELEVAZIONE=604800

# Cartella per la cache su disco
# CACHE_DIR="~/.cache/trekking-mcp"

# Territori EAWS da indicizzare (codici dei file di regions.avalanches.org).
# La Svizzera serve perche' `bollettino_valanghe` accetta il provider `slf`:
# senza i suoi perimetri, un punto svizzero non risolve e l'autocompletamento
# di zona_id per `slf` resta vuoto. Un codice inesistente non e' fatale: il
# loader logga un warning e va avanti.
# EAWS_TERRITORI="IT-21,IT-23,IT-25,IT-32-BZ,IT-32-TN,IT-34,IT-36,IT-57,CH"

# --- Transport HTTP ---

# Chiavi per sigillare il `requestState` delle interazioni a piu' round-trip
# (elicitation). Senza, l'SDK usa una chiave effimera per processo: le
# elicitation non sopravvivono a un riavvio ne' a una seconda replica. Almeno
# 32 byte per chiave; la prima sigilla, tutte verificano (rotazione: nuova in
# testa, vecchia in coda per un TTL).
#   python -c "import secrets; print(secrets.token_hex(32))"
# TREKKING_MCP_STATE_KEYS="<chiave-nuova>,<chiave-vecchia>"
